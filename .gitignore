# ─────────────────────────────────────────────────────────────
# .gitignore for Macrohard Travel Agent POC
# ─────────────────────────────────────────────────────────────

# ── Virtual environments ──────────────────────────────────────
venv/
venv312/
.venv/
env/
ENV/

# ── Secrets and credentials ───────────────────────────────────
# NEVER commit these
.env
.env.local
.env.production
*.env
.streamlit/secrets.toml

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.Python

# ── Build artifacts ───────────────────────────────────────────
lambda_build/
travel-agent-lambda.zip
*.zip
dist/
build/

# ── AWS and deployment ────────────────────────────────────────
lambda-trust-policy.json
response.json
samconfig.toml
.aws-sam/

# ── Logs ─────────────────────────────────────────────────────
*.log
agent_run_*.log
logs/

# ── IDE and OS files ──────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Test and temp files ───────────────────────────────────────
*.tmp
temp/
tmp/

# ── Jupyter notebooks (if any) ────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage and testing ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Additional ignores ────────────────────────────────────────
.venv/
.venv-1/
venv/
agent_run_*.log
test_api_calls.py
.devcontainer/
